  { src: '/photos/chaudiere-vaillant-brique.jpg', caption: 'Chaudière Vaillant — mur brique' },
  { src: '/photos/chaudiere-vaillant-pierre.jpg', caption: 'Chaudière Vaillant — pierre apparente' },
  { src: '/photos/vaillant-avant-apres.jpg', caption: 'Vaillant — avant/après' },
  { src: '/photos/remplacement-avant-apres.jpg', caption: 'Remplacement chaudière — avant/après' },
  { src: '/photos/radiateur-design-noir.jpg', caption: 'Radiateur design vertical noir' },
  // === New entries from batch 2026-05-25 ===
  { src: '/photos/plancher-chauffant-pose.jpg', caption: 'Plancher chauffant — pose en cours' },
  { src: '/photos/plancher-chauffant-collecteur.jpg', caption: 'Plancher chauffant — collecteur' },
  { src: '/photos/plancher-chauffant-pose-2.jpg', caption: 'Plancher chauffant — boucles posées' },
  { src: '/photos/plancher-chauffant-pose-3.jpg', caption: 'Plancher chauffant — vue ensemble' },
  { src: '/photos/plancher-chauffant-pose-4.jpg', caption: 'Plancher chauffant — boucles et attentes' },
  { src: '/photos/plancher-chauffant-pose-5.jpg', caption: 'Plancher chauffant — préparation séjour' },
  { src: '/photos/plancher-chauffant-detail.jpg', caption: 'Plancher chauffant — détail des boucles' },
  { src: '/photos/plancher-chauffant-finition.jpg', caption: 'Plancher chauffant — finition' },
  { src: '/photos/chauffe-eau-vaillant-gaz.jpg', caption: 'Chauffe-eau Vaillant — gaz mural' },
  { src: '/photos/chaudiere-mazout-jaune.jpg', caption: 'Chaudière mazout — cave' },
  { src: '/photos/chaudiere-bulex-cave-pierre.jpg', caption: 'Chaudière Bulex — cave en pierre' },
  { src: '/photos/chaudiere-mazout-ancienne.jpg', caption: 'Ancienne chaudière mazout — avant remplacement' },
  { src: '/photos/chaudiere-vaillant-cuisine.jpg', caption: 'Chaudière Vaillant — intégrée cuisine' },
  { src: '/photos/chaudiere-vaillant-collecteur.jpg', caption: 'Chaudière Vaillant — collecteur détaillé' },
  { src: '/photos/radiateur-classique-blanc.jpg', caption: 'Radiateur classique — installation neuve' },
  { src: '/photos/chaudiere-entretien-avant.jpg', caption: 'Chaudière — chambre de combustion avant nettoyage' },
  { src: '/photos/radiateur-ancien-fonte.jpg', caption: 'Ancien radiateur — avant remplacement' },
  { src: '/photos/chaudiere-vaillant-garage.jpg', caption: 'Chaudière Vaillant — garage' },
  { src: '/photos/chaudiere-vaillant-sdb.jpg', caption: 'Chaudière Vaillant — salle de bain' },
  { src: '/photos/poele-pellets-noir.jpg', caption: 'Poêle à pellets — salon' },
];

const galSanitaire = [
  { src: '/photos/sdb-baignoire-ilot-moderne.jpg', caption: 'Salle de bain — baignoire îlot &amp; douche italienne' },
  { src: '/photos/sdb-double-vasque-bois.jpg', caption: 'Double vasque sur meuble bois' },
  { src: '/photos/sdb-baignoire-balneo-marbre.jpg', caption: 'Baignoire balnéo — finition marbre' },
  { src: '/photos/douche-italienne-motifs.jpg', caption: 'Douche italienne — carrelage motifs' },
  { src: '/photos/baignoire-ilot.jpg', caption: 'Baignoire îlot — finition épurée' },
  { src: '/photos/douche-italienne.jpg', caption: 'Douche italienne sur mesure' },
  { src: '/photos/chauffe-eau-atlantic.jpg', caption: 'Chauffe-eau Atlantic connecté' },
  // === New entries from batch 2026-05-25 ===
  { src: '/photos/sdb-baignoire-ilot-marbre.jpg', caption: 'Salle de bain — baignoire îlot &amp; vasques' },
  { src: '/photos/tuyauterie-per-attentes.jpg', caption: 'Tuyauterie PER — attentes sanitaires' },
  { src: '/photos/tuyauterie-per-cave.jpg', caption: 'Tuyauterie PER — passage en cave' },
  { src: '/photos/douche-italienne-marbre.jpg', caption: 'Douche italienne — marbre et robinetterie noire' },
  { src: '/photos/tuyauterie-per-attentes-2.jpg', caption: 'Tuyauterie PER — attentes au sol' },
  { src: '/photos/sdb-marbre-vasque-radiateur.jpg', caption: 'Salle de bain — marbre et sèche-serviettes' },
  { src: '/photos/sdb-marbre-wc-vasque.jpg', caption: 'Salle de bain — WC et vasque marbre' },
  { src: '/photos/sdb-ensemble-vasques-douche.jpg', caption: 'Salle de bain — ensemble vasques et douche' },
  { src: '/photos/douche-italienne-radiateur-design.jpg', caption: 'Douche italienne et radiateur design' },
  { src: '/photos/tuyauterie-per-cave-2.jpg', caption: 'Tuyauterie PER — desserte en cave' },
  { src: '/photos/collecteur-sanitaire-cave.jpg', caption: 'Collecteur sanitaire — cave voûtée' },
  { src: '/photos/sdb-renovation-complete.jpg', caption: 'Salle de bain — rénovation complète' },
  { src: '/photos/sdb-cabine-douche.jpg', caption: 'Salle de bain — cabine de douche et vasque' },
  { src: '/photos/sanitaire-arrivees-eau.jpg', caption: 'Sanitaire — arrivées eau avant pose' },
  { src: '/photos/sdb-carrelage-attentes-douche.jpg', caption: 'Salle de bain — carrelage et attentes douche' },
  { src: '/photos/sdb-vasque-meuble-bois.jpg', caption: 'Salle de bain — vasque sur meuble bois' },
  { src: '/photos/douche-italienne-receveur-noir.jpg', caption: 'Douche italienne — receveur noir' },
  { src: '/photos/sdb-renovation-douche.jpg', caption: 'Salle de bain — rénovation douche italienne' },
];

const galAdoucisseur = [
  { src: '/photos/solucalc-bouteille-co2.jpg', caption: 'Solucalc — bouteille CO₂' },
  { src: '/photos/solucalc-equipe-installation.jpg', caption: 'Installation Solucalc en cours' },
  { src: '/photos/solucalc-installateur-agree.jpg', caption: 'Installateur agréé Solucalc' },
];

const galEquipe = [
  { src: '/photos/equipe-chauffage-et-moi.jpg', caption: 'Technicien Chauffage &amp; Moi — entretien chaudière mazout' },
  { src: '/photos/technicien-bruleur.jpg', caption: 'Entretien brûleur — agréés G1·G2' },
  { src: '/photos/technicien.jpg', caption: 'Technicien sur intervention' },
