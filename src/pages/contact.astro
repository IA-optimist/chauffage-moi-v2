---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact & Devis gratuit" description="Contactez Chauffage & Moi pour un devis gratuit sous 24h. Chauffagiste et plombier à Mons et dans le Hainaut. Urgences 7j/7. WhatsApp 0491 87 34 19.">
  
  <section class="pt-32 pb-20 bg-gradient-to-br from-[#1B3A5C] to-[#0D1F33]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-[family-name:Playfair_Display,serif] font-bold text-white mb-6">Contactez-nous</h1>
      <p class="text-xl text-blue-200 max-w-2xl mx-auto">Devis gratuit sous 24h. Intervention rapide dans tout le Hainaut.</p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact info -->
        <div>
          <h2 class="text-2xl font-bold font-[family-name:Playfair_Display,serif] text-[#1B3A5C] mb-8">Nos coordonnées</h2>
          
          <div class="space-y-6">
            <a href="https://wa.me/32491873419" target="_blank" rel="noopener" class="flex items-center gap-4 p-5 bg-green-50 rounded-2xl hover:bg-green-100 transition-colors group">
              <div class="w-14 h-14 bg-[#25D366] rounded-xl flex items-center justify-center text-white text-2xl shrink-0">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900 group-hover:text-[#25D366] transition-colors">WhatsApp</p>
                <p class="text-gray-500">0491 87 34 19</p>
              </div>
              <span class="ml-auto text-[#25D366] text-sm font-medium">Cliquez →</span>
            </a>

            <a href="tel:+32491873419" class="flex items-center gap-4 p-5 bg-orange-50 rounded-2xl hover:bg-orange-100 transition-colors group">
              <div class="w-14 h-14 bg-[#E8521A] rounded-xl flex items-center justify-center text-white text-2xl shrink-0">📞</div>
              <div>
                <p class="font-semibold text-gray-900 group-hover:text-[#E8521A] transition-colors">Téléphone</p>
                <p class="text-gray-500">0491 87 34 19</p>
              </div>
              <span class="ml-auto text-[#E8521A] text-sm font-medium">Appeler →</span>
            </a>

            <div class="flex items-center gap-4 p-5 bg-blue-50 rounded-2xl">
              <div class="w-14 h-14 bg-[#1B3A5C] rounded-xl flex items-center justify-center text-white text-2xl shrink-0">✉️</div>
              <div>
                <p class="font-semibold text-gray-900">Email</p>
                <p class="text-gray-500">info@chauffageetmoi.com</p>
              </div>
            </div>

            <div class="flex items-center gap-4 p-5 bg-gray-50 rounded-2xl">
              <div class="w-14 h-14 bg-gray-700 rounded-xl flex items-center justify-center text-white text-2xl shrink-0">📍</div>
              <div>
                <p class="font-semibold text-gray-900">Adresse</p>
                <p class="text-gray-500">Ghlin, Mons, Hainaut, Belgique</p>
              </div>
            </div>

            <div class="flex items-center gap-4 p-5 bg-gray-50 rounded-2xl">
              <div class="w-14 h-14 bg-gray-700 rounded-xl flex items-center justify-center text-white text-2xl shrink-0">🕐</div>
              <div>
                <p class="font-semibold text-gray-900">Horaires</p>
                <p class="text-gray-500">Lun-Ven 8h-18h · Urgences 7j/7</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div>
          <h2 class="text-2xl font-bold font-[family-name:Playfair_Display,serif] text-[#1B3A5C] mb-8">Demande de devis</h2>
          <p class="text-gray-600 mb-6">Remplissez le formulaire ci-dessous et nous vous répondrons sous 24h avec un devis gratuit et personnalisé.</p>
          
          <form class="space-y-5" action="https://formspree.io/f/placeholder" method="POST">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Nom</label>
                <input type="text" name="nom" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#E8521A] focus:ring-2 focus:ring-orange-100 outline-none transition-colors" placeholder="Votre nom" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Prénom</label>
                <input type="text" name="prenom" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#E8521A] focus:ring-2 focus:ring-orange-100 outline-none transition-colors" placeholder="Votre prénom" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Téléphone</label>
              <input type="tel" name="telephone" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#E8521A] focus:ring-2 focus:ring-orange-100 outline-none transition-colors" placeholder="04xx xx xx xx" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
              <input type="email" name="email" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#E8521A] focus:ring-2 focus:ring-orange-100 outline-none transition-colors" placeholder="votre@email.com" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Service souhaité</label>
              <select name="service" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#E8521A] focus:ring-2 focus:ring-orange-100 outline-none transition-colors">
                <option value="">Choisissez un service</option>
                <option value="chaudiere">Chaudière</option>
                <option value="pompe-chaleur">Pompe à chaleur</option>
                <option value="sanitaire">Sanitaire / Salle de bain</option>
                <option value="adoucisseur">Adoucisseur d'eau</option>
                <option value="depannage">Dépannage urgent</option>
                <option value="autre">Autre</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
              <textarea name="message" rows="4" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#E8521A] focus:ring-2 focus:ring-orange-100 outline-none transition-colors" placeholder="Décrivez votre projet ou votre besoin..."></textarea>
            </div>
            <button type="submit" class="w-full bg-[#E8521A] hover:bg-[#d4461a] text-white font-bold text-lg py-4 px-8 rounded-full transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1">
              Envoyer la demande
            </button>
            <p class="text-xs text-gray-400 text-center mt-3">
              En soumettant ce formulaire, vous acceptez d'être contacté par Chauffage & Moi.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
