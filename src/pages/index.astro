---
import Layout from '../layouts/Layout.astro';

const communesHainaut = [
  'Aiseau-Presles', 'Anderlues', 'Antoing', 'Ath', 'Beaumont', 'Beloeil', 'Bernissart', 'Binche', 'Boussu', 'Braine-le-Comte',
  'Brugelette', 'Brunehaut', 'Celles', 'Chapelle-lez-Herlaimont', 'Charleroi', 'Châtelet', 'Chièvres', 'Chimay', 'Colfontaine',
  'Comines-Warneton', 'Courcelles', 'Dour', 'Écaussinnes', 'Ellezelles', 'Enghien', 'Erquelinnes', 'Estaimpuis', 'Estinnes',
  'Farciennes', 'Fleurus', 'Flobecq', 'Fontaine-l\'Évêque', 'Frameries', 'Frasnes-lez-Anvaing', 'Froidchapelle', 'Gerpinnes',
  'Ham-sur-Heure-Nalinnes', 'Hensies', 'Honnelles', 'Jurbise', 'La Louvière', 'Le Roeulx', 'Lens', 'Les Bons Villers',
  'Lessines', 'Leuze-en-Hainaut', 'Lobbes', 'Manage', 'Merbes-le-Château', 'Momignies', 'Mons', 'Mont-de-l\'Enclus',
  'Montigny-le-Tilleul', 'Morlanwelz', 'Mouscron', 'Pecq', 'Péruwelz', 'Pont-à-Celles', 'Quaregnon', 'Quévy',
  'Quiévrain', 'Rumes', 'Saint-Ghislain', 'Seneffe', 'Silly', 'Sivry-Rance', 'Soignies', 'Thuin', 'Tournai'
];

// Avis Google authentiques — Chauffage & Moi (Coquis-Meunier)
const googleReviews = [
  { name: 'Valérie Gehenot', rating: 5, text: 'Super équipe, dynamique, organisée, ils donnent des idées neuves pour nos projets, très contente du résultat et du suivi des travaux, je les conseille les yeux fermés.', date: '2026-04-15' },
  { name: 'Patrice Chevalier', rating: 5, text: 'Super équipe, on réalise un travail titanesque à la maison : remplacement total tuyauterie eau, installation d\'une PAC air-eau, nouveaux radiateurs et arrivée à d\'autres endroits que j\'ai choisis.', date: '2026-04-05' },
  { name: 'Joanne Knecht', rating: 5, text: 'Équipe pro, fiable, je recommande vivement 👍', date: '2026-03-12' },
  { name: 'Nora Aia', rating: 5, text: 'Nous sommes entièrement satisfaits de notre nouvelle installation de chauffage avec la chaudière à condensation, ainsi que de la nouvelle tuyauterie d\'eau dans la maison. Le travail a été réalisé avec sérieux et professionnalisme.', date: '2026-03-02' },
  { name: 'Fatima Ramdani', rating: 5, text: 'Nous vous recommandons grandement. Travail propre et méticuleux. Et les prix sont plus que raisonnables vu le boulot fourni. Encore un grand merci à vous pour votre professionnalisme.', date: '2026-02-10' },
  { name: 'David Puvilland', rating: 4, text: 'Travail propre et personnes très aimables !', date: '2026-02-05' },
  { name: 'Laura Lorenz', rating: 5, text: 'Rapidité. Efficacité. Je recommande.', date: '2026-01-20' },
  { name: 'Kiki Gloria', rating: 5, text: 'Top et sérieux, prix très correct.', date: '2026-01-08' },
  { name: 'Sébastien Reumont', rating: 5, text: 'Je cherchais un prestataire de service pour un simple ramonage de cheminée et au final j\'ai trouvé une entreprise à l\'écoute et qui fait un travail parfait pour des prix plus que raisonnables.', date: '2025-12-15' },
  { name: 'Meylemans Christopher', rating: 5, text: 'Prise de contact un dimanche et intervention le lundi après-midi : une société qui ne laisse pas les clients dans l\'embarras avec un problème de tuyauterie pour finir le placement de la cuisine.', date: '2025-12-10' },
  { name: 'Tennessee Bellez', rating: 5, text: 'Je recommande à 200% ! Réalisation de ma salle de bain avec leurs services. De bonnes idées du début jusqu\'à la fin. Du matériel de bonne qualité avec leurs conseils avisés. À bientôt, sans aucun doute.', date: '2025-12-04' },
  { name: 'Cédric Trautes', rating: 5, text: 'Installation impeccable du début à la fin. Société sérieuse, équipe réactive et très professionnelle. Les explications sont claires, le chantier est propre et le résultat parfaitement fonctionnel. Un vrai partenaire de confiance.', date: '2025-11-28' },
  { name: 'Mehdi Allali', rating: 5, text: 'Entreprise très professionnelle et à l\'écoute de mes demandes. Équipe honnête, sérieuse et toujours prête à trouver une solution. Je ne peux que les recommander ! Un grand merci à Sébastien pour son professionnalisme et sa gentillesse.', date: '2025-11-22' },
  { name: 'Tony Di Lella', rating: 5, text: '🌟 Excellent service ! Je tiens à souligner le sérieux de la société Chauffage et Moi. Ponctualité irréprochable : le monsieur est venu ce jour même pour réaliser le travail.', date: '2025-11-15' },
  { name: 'Jenny Charlier', rating: 5, text: 'Une équipe de chauffagistes au top du top ! Nous sommes vraiment ravis de leur intervention. Dès le début, ils ont été très gentils, disponibles et à l\'écoute. Ils ont pris le temps de tout nous expliquer.', date: '2025-11-10' },
  { name: 'Stephanie Aubly', rating: 5, text: 'Installation complète à mon domicile et très professionnels avec de bonnes explications claires et complètes, n\'hésitent pas à répondre en cas de questions et le chantier a été effectué rapidement.', date: '2025-11-08' },
  { name: 'Rochdi Hassani', rating: 5, text: 'Top, rien à dire. Une très bonne installation, propre et respect des délais. Aucun regret.', date: '2025-11-04' },
  { name: 'Enzo Cp', rating: 5, text: 'Équipe de professionnels. Travail propre et soigné, et dans la bonne humeur ! Vous pouvez y aller les yeux fermés.', date: '2025-11-02' },
  { name: 'Azahara H', rating: 5, text: 'Rapide, efficace.', date: '2025-11-01' },
  { name: 'Fouzi Feriati', rating: 5, text: 'Deux personnes sérieuses, ponctuelles et professionnelles. Je recommande vivement !', date: '2025-10-12' },
];

const googleReviewsUrl = 'https://www.google.com/maps/place/Chauffage+%26+Moi+(Coquis-Meunier)';
const totalReviews = googleReviews.length;
const avgRating = (googleReviews.reduce((s, r) => s + r.rating, 0) / totalReviews).toFixed(1).replace('.', ',');

const stats = [
  { value: '15+', label: 'ans expérience' },
  { value: '500+', label: 'clients satisfaits' },
  { value: '7j/7', label: 'urgences' },
  { value: 'G1·G2·L1', label: 'Agréés' },
];
---

<Layout description="Chauffagiste et plombier à Mons et dans le Hainaut. Installation chaudières, pompes à chaleur, adoucisseurs, sanitaire. Agréés G1·G2·L1. Urgences 7j/7. Devis gratuit sous 24h.">
  
  <!-- Hero Section - Split -->
  <section class="bg-stone-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <!-- Texte -->
        <div class="order-2 lg:order-1">
          <div class="inline-flex items-center gap-2 bg-white border border-stone-200 rounded-full px-4 py-1.5 mb-6 shadow-sm">
            <span class="w-2 h-2 bg-whatsapp rounded-full animate-pulse"></span>
            <span class="text-stone-700 text-xs font-medium">Agréés G1 · G2 · L1 — Urgences 7j/7</span>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tightish text-marine leading-[1.05] mb-6">
            Votre confort,<br/>notre expertise.
          </h1>
          <p class="text-lg text-stone-600 mb-8 max-w-lg leading-relaxed">
            Chauffage · Sanitaire · Pompes à chaleur.<br class="hidden sm:block" />
            Mons &amp; Hainaut — Devis gratuit sous 24h.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 mb-6">
            <a href="/contact" class="btn-primary">
              Demander un devis gratuit
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="https://wa.me/32491873419" target="_blank" rel="noopener" class="btn-whatsapp">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </div>
          <a href="#avis-google" class="inline-flex items-center gap-2 text-stone-600 hover:text-marine text-sm transition-colors">
            <span class="text-yellow-400">★★★★★</span>
            <span><strong class="text-marine">4,9/5</strong> sur 20 avis Google</span>
          </a>
        </div>
        <!-- Photo -->
        <div class="order-1 lg:order-2">
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-xl">
            <img src="/photos/equipe-travail.jpg" alt="Équipe Chauffage &amp; Moi sur chantier" class="w-full h-full object-cover" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="relative -mt-10 z-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="bg-white rounded-2xl shadow-2xl p-8 grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map(s => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-[#1B3A5C] font-[family-name:Playfair_Display,serif]">{s.value}</div>
            <div class="text-gray-500 text-sm mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-24 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-[#1B3A5C]">Tout pour votre confort</h2>
      <p class="section-subtitle">Une seule entreprise, tous les savoir-faire.</p>
      <div class="grid md:grid-cols-3 gap-8">
        <a href="/services#chauffage" class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center mb-6 text-2xl">🔥</div>
          <h3 class="text-xl font-bold mb-3 font-[family-name:Playfair_Display,serif] group-hover:text-[#E8521A] transition-colors">Chaudières</h3>
          <p class="text-gray-600 leading-relaxed">Installation, remplacement et entretien annuel. Gaz, mazout, condensation. Agréés G1 · G2.</p>
        </a>
        <a href="/services#energies" class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center mb-6 text-2xl">🌿</div>
          <h3 class="text-xl font-bold mb-3 font-[family-name:Playfair_Display,serif] group-hover:text-[#E8521A] transition-colors">Pompes à chaleur</h3>
          <p class="text-gray-600 leading-relaxed">Air/eau, géothermie, systèmes hybrides. Audit énergétique et accompagnement aux primes.</p>
        </a>
        <a href="/services#sanitaire" class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-6 text-2xl">🚿</div>
          <h3 class="text-xl font-bold mb-3 font-[family-name:Playfair_Display,serif] group-hover:text-[#E8521A] transition-colors">Sanitaire</h3>
          <p class="text-gray-600 leading-relaxed">Salles de bain complètes, douches, baignoires, chauffe-eaux, adoucisseurs, détection fuites.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Gamme Adoucisseurs -->
  <section id="gamme" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-[#E8521A] font-semibold text-sm uppercase tracking-widest text-center block mb-4">Notre gamme</span>
      <h2 class="section-title text-[#1B3A5C]">Adoucisseurs d'eau</h2>
      <p class="section-subtitle">Deux technologies complémentaires pour une eau parfaitement douce. Choisissez la solution qui correspond à vos besoins.</p>
      
      <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto">
        <!-- Solucalc -->
        <div class="bg-[#F8FAFC] rounded-3xl p-8 lg:p-10 border-2 border-transparent hover:border-[#1B3A5C] transition-all duration-300 relative overflow-hidden group">
          <div class="absolute top-0 right-0 bg-green-500 text-white px-4 py-1 rounded-bl-xl text-xs font-bold uppercase tracking-wider">Écologique</div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center text-3xl">💧</div>
            <div>
              <h3 class="text-2xl font-bold font-[family-name:Playfair_Display,serif] text-[#1B3A5C]">Solucalc</h3>
              <p class="text-green-600 font-semibold text-sm">Technologie au CO₂</p>
            </div>
          </div>
          <p class="text-gray-600 mb-8 leading-relaxed">
            L'adoucisseur écologique qui utilise le dioxyde de carbone pour neutraliser le calcaire sans sel, sans électricité et sans rejet. Respectueux de l'environnement, il préserve les minéraux essentiels de l'eau.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-green-500 mt-1">✓</span> <span><strong>Zéro sel</strong> — aucun sac à transporter</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-green-500 mt-1">✓</span> <span><strong>Zéro électricité</strong> — fonctionnement 100% mécanique</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-green-500 mt-1">✓</span> <span><strong>Zéro rejet</strong> — pas d'eau gaspillée</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-green-500 mt-1">✓</span> <span><strong>Minéraux préservés</strong> — calcium et magnésium conservés</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-green-500 mt-1">✓</span> <span><strong>Entretien minimal</strong> — cartouche à changer tous les 2-3 ans</span>
            </li>
          </ul>
          <div class="text-center">
            <span class="text-3xl font-bold text-[#1B3A5C] font-[family-name:Playfair_Display,serif]">À partir de 1.490€</span>
            <p class="text-gray-500 text-sm mt-1">HTVA, pose comprise</p>
          </div>
          <div class="mt-6 text-center">
            <a href="https://wa.me/32491873419?text=Bonjour%2C%20je%20souhaite%20un%20devis%20pour%20l%27adoucisseur%20Solucalc" target="_blank" rel="noopener" class="btn-green text-sm px-6 py-3">
              Devis Solucalc WhatsApp
            </a>
          </div>
        </div>

        <!-- Durlem -->
        <div class="bg-[#F8FAFC] rounded-3xl p-8 lg:p-10 border-2 border-transparent hover:border-[#1B3A5C] transition-all duration-300 relative overflow-hidden group">
          <div class="absolute top-0 right-0 bg-[#1B3A5C] text-white px-4 py-1 rounded-bl-xl text-xs font-bold uppercase tracking-wider">Best-seller</div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center text-3xl">🧂</div>
            <div>
              <h3 class="text-2xl font-bold font-[family-name:Playfair_Display,serif] text-[#1B3A5C]">Durlem</h3>
              <p class="text-blue-600 font-semibold text-sm">Technologie au sel</p>
            </div>
          </div>
          <p class="text-gray-600 mb-8 leading-relaxed">
            L'adoucisseur à résine échangeuse d'ions, la solution traditionnelle éprouvée pour une eau parfaitement douce. Régénération automatique au sel, idéal pour les grandes familles et les eaux très dures du Hainaut.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-blue-500 mt-1">✓</span> <span><strong>Eau ultra-douce</strong> — 0°TH, fini les traces de calcaire</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-blue-500 mt-1">✓</span> <span><strong>Grande capacité</strong> — jusqu'à 6 personnes</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-blue-500 mt-1">✓</span> <span><strong>Régénération intelligente</strong> — s'adapte à votre consommation</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-blue-500 mt-1">✓</span> <span><strong>Protection électroménager</strong> — prolonge la durée de vie</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-blue-500 mt-1">✓</span> <span><strong>Garantie 5 ans</strong> — pièces et main d'œuvre</span>
            </li>
          </ul>
          <div class="text-center">
            <span class="text-3xl font-bold text-[#1B3A5C] font-[family-name:Playfair_Display,serif]">À partir de 1.190€</span>
            <p class="text-gray-500 text-sm mt-1">HTVA, pose comprise</p>
          </div>
          <div class="mt-6 text-center">
            <a href="https://wa.me/32491873419?text=Bonjour%2C%20je%20souhaite%20un%20devis%20pour%20l%27adoucisseur%20Durlem" target="_blank" rel="noopener" class="btn-green text-sm px-6 py-3">
              Devis Durlem WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Comparison table -->
      <div class="mt-16 max-w-3xl mx-auto bg-[#F8FAFC] rounded-2xl p-8">
        <h3 class="text-xl font-bold font-[family-name:Playfair_Display,serif] text-center text-[#1B3A5C] mb-8">Comparatif Solucalc vs Durlem</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="py-3 pr-4 text-gray-500 font-medium">Critère</th>
                <th class="py-3 px-4 text-center text-green-700 font-bold">Solucalc CO₂</th>
                <th class="py-3 pl-4 text-center text-blue-700 font-bold">Durlem Sel</th>
              </tr>
            </thead>
            <tbody class="text-gray-700">
              <tr class="border-b border-gray-100"><td class="py-3 pr-4">Technologie</td><td class="py-3 px-4 text-center">CO₂ sous pression</td><td class="py-3 pl-4 text-center">Résine échangeuse d'ions</td></tr>
              <tr class="border-b border-gray-100"><td class="py-3 pr-4">Consommation sel</td><td class="py-3 px-4 text-center font-bold text-green-600">Aucune</td><td class="py-3 pl-4 text-center">~2 sacs/mois</td></tr>
              <tr class="border-b border-gray-100"><td class="py-3 pr-4">Électricité</td><td class="py-3 px-4 text-center font-bold text-green-600">Aucune</td><td class="py-3 pl-4 text-center">Faible (transfo)</td></tr>
              <tr class="border-b border-gray-100"><td class="py-3 pr-4">Rejet eau</td><td class="py-3 px-4 text-center font-bold text-green-600">Aucun</td><td class="py-3 pl-4 text-center">~30L/régénération</td></tr>
              <tr class="border-b border-gray-100"><td class="py-3 pr-4">Entretien</td><td class="py-3 px-4 text-center">Cartouche / 2-3 ans</td><td class="py-3 pl-4 text-center">Sel + contrôle annuel</td></tr>
              <tr class="border-b border-gray-100"><td class="py-3 pr-4">Dureté obtenue</td><td class="py-3 px-4 text-center">~8-12°TH</td><td class="py-3 pl-4 text-center font-bold">0°TH</td></tr>
              <tr><td class="py-3 pr-4">Idéal pour</td><td class="py-3 px-4 text-center">Écologie, santé</td><td class="py-3 pl-4 text-center">Confort maximal</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Réalisations -->
  <section class="py-24 bg-[#1B3A5C] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-orange-300 font-semibold text-sm uppercase tracking-widest text-center block mb-4">Nos chantiers finis</span>
      <h2 class="section-title text-white">Travail propre, finitions soignées</h2>
      <p class="section-subtitle text-blue-200">Des réalisations livrées à des clients heureux dans tout le Hainaut.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5 mt-12">
        {[
          { src: '/photos/sdb-renovation.jpg', label: 'Salle de bain rénovée' },
          { src: '/photos/baignoire-ilot.jpg', label: 'Baignoire îlot' },
          { src: '/photos/douche-italienne.jpg', label: 'Douche italienne' },
          { src: '/photos/plancher-chauffant2.jpg', label: 'Plancher chauffant' },
          { src: '/photos/vaillant-avant-apres.jpg', label: 'Chaudière condensation · avant/après' },
          { src: '/photos/remplacement-avant-apres.jpg', label: 'Remplacement installation · avant/après' },
          { src: '/photos/tuyauterie-per.jpg', label: 'Tuyauterie multi-couche' },
          { src: '/photos/equipe-travail.jpg', label: 'Notre équipe sur chantier' },
        ].map(item => (
          <button type="button" data-lightbox="realisations" data-lightbox-src={item.src} data-lightbox-caption={item.label} class="relative group overflow-hidden rounded-2xl aspect-[4/3] shadow-xl cursor-zoom-in text-left">
            <img src={item.src} alt={item.label} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 text-white">
              <p class="font-semibold text-xs sm:text-sm md:text-base leading-tight">{item.label}</p>
            </div>
          </button>
        ))}
      </div>
      <p class="text-center text-blue-200 text-sm mt-8 italic">Cliquez sur une photo pour ouvrir la galerie complète</p>
    </div>
  </section>

  <!-- Témoignages Google avis -->
  <section id="avis-google" class="py-24 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-[#E8521A] font-semibold text-sm uppercase tracking-widest text-center block mb-4">Avis Google vérifiés</span>
      <h2 class="section-title text-[#1B3A5C]">Ce que disent nos clients</h2>
      <p class="section-subtitle">{totalReviews} avis Google de clients satisfaits dans tout le Hainaut.</p>

      <!-- Google rating summary -->
      <div class="flex flex-col items-center mb-14 mt-8">
        <div class="bg-white rounded-2xl shadow-lg px-8 py-6 flex flex-col items-center">
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-7 h-7" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
              <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
              <path fill="#FF3D00" d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
              <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
              <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
            </svg>
            <span class="text-5xl font-bold text-[#1B3A5C] font-[family-name:Playfair_Display,serif]">{avgRating}</span>
            <span class="text-gray-400 text-2xl">/ 5</span>
          </div>
          <div class="flex gap-1 text-yellow-400 text-2xl mb-3">★★★★★</div>
          <p class="text-sm text-gray-500 mb-3">Basé sur {totalReviews} avis Google</p>
          <a href={googleReviewsUrl} target="_blank" rel="noopener" class="text-sm text-[#E8521A] hover:underline font-medium inline-flex items-center gap-1">
            Voir tous les avis sur Google
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Reviews grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {googleReviews.map(review => (
          <article class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-shadow border border-gray-100">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-11 h-11 bg-gradient-to-br from-[#1B3A5C] to-[#2d5680] rounded-full flex items-center justify-center text-white font-bold shrink-0">
                {review.name.charAt(0)}
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-900 truncate">{review.name}</p>
                <p class="text-xs text-gray-400">
                  {new Date(review.date).toLocaleDateString('fr-BE', { year: 'numeric', month: 'long' })}
                </p>
              </div>
              <div class="text-yellow-400 text-sm tracking-tight">{'★'.repeat(review.rating)}<span class="text-gray-200">{'★'.repeat(5 - review.rating)}</span></div>
            </div>
            <p class="text-gray-600 leading-relaxed text-sm">
              &ldquo;{review.text}&rdquo;
            </p>
          </article>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href={googleReviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-white border-2 border-[#1B3A5C] text-[#1B3A5C] hover:bg-[#1B3A5C] hover:text-white font-semibold px-8 py-3 rounded-full transition-all duration-300">
          Lire tous les avis sur Google
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Zone d'intervention SEO -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-[#1B3A5C]">Zone d'intervention</h2>
      <p class="section-subtitle">Basés à Ghlin, au cœur de la région de Mons. Devis gratuit dans tout le Hainaut.</p>
      
      <div class="bg-[#F8FAFC] rounded-2xl p-8 max-w-5xl mx-auto">
        <h3 class="text-lg font-bold text-[#1B3A5C] mb-6 text-center">Nous intervenons dans toutes les communes du Hainaut</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
          {communesHainaut.map(commune => (
            <span class="text-sm text-gray-600 hover:text-[#E8521A] transition-colors py-1 px-2 rounded-lg hover:bg-orange-50">
              {commune}
            </span>
          ))}
        </div>
        <p class="text-center text-gray-500 text-sm mt-8">
          Vous ne trouvez pas votre commune ? Contactez-nous — nous couvrons l'ensemble du Hainaut et ses environs.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-[#E8521A] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white font-[family-name:Playfair_Display,serif] mb-6">
        Prêt à améliorer votre confort ?
      </h2>
      <p class="text-xl text-orange-100 mb-10 max-w-2xl mx-auto">
        Devis gratuit sous 24h — Intervention rapide dans tout le Hainaut
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-white text-[#E8521A] hover:bg-orange-50 px-8 py-4 rounded-full font-bold text-lg transition-all duration-300 shadow-xl hover:-translate-y-1">
          Demander un devis
        </a>
        <a href="https://wa.me/32491873419" target="_blank" rel="noopener" class="bg-[#25D366] hover:bg-[#1da851] text-white px-8 py-4 rounded-full font-bold text-lg transition-all duration-300 shadow-xl hover:-translate-y-1 inline-flex items-center justify-center gap-2">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>

</Layout>
